{
  "listen": ":8080",
  "mcp": { "enable": true, "listen": ":8081", "path": "/mcp" },
  "web": {
    "enable": true,
    "listen": ":8082",
    "users_file": "/var/lib/airlock/users.json",
    "token_ttl": "12h",
    "bootstrap": {
      "username": "admin",
      "password": "env:AIRLOCK_ADMIN_PASSWORD",
      "groups": ["sre"]
    }
  },
  "groups": ["team-checkout", "team-payments", "sre"],
  "clients": [
    {
      "id": "checkout-bot",
      "token": "replace-with-a-strong-secret-token",
      "groups": ["team-checkout"],
      "allow": ["redis.get"],
      "rate_limit": { "rps": 10, "burst": 20 }
    },
    {
      "id": "payments-bot",
      "token": "another-strong-secret-token",
      "groups": ["team-payments"],
      "rate_limit": { "rps": 10, "burst": 20 }
    },
    {
      "id": "sre-observer",
      "token": "a-third-strong-secret-token",
      "groups": ["sre"],
      "rate_limit": { "rps": 5, "burst": 10 }
    }
  ],
  "backends": {
    "redis": { "addr": "127.0.0.1:6379" },
    "httpproxy": [
      {
        "name": "victorialogs-a",
        "type": "victorialogs",
        "base_url": "http://victorialogs-a.internal:9428",
        "allowed_groups": ["team-checkout"],
        "max_response_bytes": 1048576,
        "max_result_limit": 1000,
        "result_limit_param": "limit",
        "grants": [
          {
            "group": "team-checkout",
            "endpoints": ["vl.query", "vl.hits"],
            "scope": {
              "victorialogs": {
                "account_id": "1",
                "project_id": "10",
                "mandatory_filter": "app:\"checkout\""
              }
            }
          }
        ]
      },
      {
        "name": "victorialogs-b",
        "type": "victorialogs",
        "base_url": "http://victorialogs-b.internal:9428",
        "allowed_groups": ["team-payments"],
        "max_response_bytes": 1048576,
        "max_result_limit": 500,
        "result_limit_param": "limit",
        "grants": [
          {
            "group": "team-payments",
            "endpoints": ["vl.query"],
            "scope": {
              "victorialogs": {
                "account_id": "2",
                "project_id": "20",
                "mandatory_filter": "app:\"payments\""
              }
            }
          }
        ]
      },
      {
        "name": "grafana-main",
        "type": "grafana",
        "base_url": "http://grafana.internal:3000",
        "allowed_groups": ["sre"],
        "max_response_bytes": 2097152,
        "upstream_auth": {
          "Authorization": "env:GRAFANA_TOKEN"
        },
        "grants": [
          {
            "group": "sre",
            "endpoints": ["grafana.search", "grafana.dashboard_get", "grafana.ds_query"],
            "scope": {}
          }
        ]
      }
    ]
  }
}
